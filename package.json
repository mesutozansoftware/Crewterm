{
  "name": "crewterm",
  "version": "0.2.0",
  "description": "Run Claude Code, Codex, and other AI coding agents side by side in one window — as a team.",
  "main": "src/main.js",
  "scripts": {
    "start": "electron .",
    "postinstall": "electron-rebuild -f -w node-pty",
    "test": "node test/e2e.js && node test/worktree.js",
    "icon": "electron scripts/render-icon.cjs && sips -z 256 256 build/icon.png --out src/ui/icon.png",
    "dist:mac": "electron-builder --mac",
    "dist:win": "electron-builder --win",
    "dist:linux": "electron-builder --linux"
  },
  "keywords": [
    "claude-code",
    "codex",
    "mcp",
    "multi-agent",
    "ai-agents",
    "terminal",
    "electron"
  ],
  "author": "mesutozansoftware",
  "license": "MIT",
  "type": "module",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "node-pty": "^1.1.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@electron/rebuild": "^4.2.0",
    "electron": "^44.4.3",
    "electron-builder": "^26.15.3"
  },
  "allowScripts": {
    "node-pty@1.1.0": true,
    "electron@44.4.3": true
  },
  "productName": "Crewterm",
  "build": {
    "appId": "dev.crewterm.app",
    "productName": "Crewterm",
    "asar": false,
    "npmRebuild": false,
    "directories": {
      "buildResources": "build",
      "output": "dist"
    },
    "files": [
      "src/**",
      "mcp/**",
      "package.json",
      "!**/*.map"
    ],
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ],
      "category": "public.app-category.developer-tools",
      "icon": "build/icon.png",
      "identity": "-",
      "hardenedRuntime": false
    },
    "dmg": {
      "title": "Crewterm"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.png",
      "files": [
        "!node_modules/node-pty/build/**"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "shortcutName": "Crewterm"
    },
    "linux": {
      "target": [
        "AppImage"
      ],
      "category": "Development",
      "icon": "build/icon.png"
    }
  },
  "homepage": "https://github.com/mesutozansoftware/Crewterm#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mesutozansoftware/Crewterm.git"
  },
  "bugs": {
    "url": "https://github.com/mesutozansoftware/Crewterm/issues"
  }
}
